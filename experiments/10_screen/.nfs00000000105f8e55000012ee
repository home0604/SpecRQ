#!/usr/bin/env bash
# E5 Qwen configuration screening (no block fine-tune): Hadamard, uniform alpha 1/L, wikitext2 1024x4096, accum fp64,
# AQ max_epochs default (1000, rel_tol 0.01 early stop), --finetune_max_epochs 0 (finetune_groupwise then only runs the
# pre-training validation pass and returns the AQ parameters unchanged).
#   1) quantize + PPL @4096 for k=L..1  2) per draft prefix kd: A (target-copy draft, + FP16 fidelity) and
#   B (TV-trained draft copy, pile_val_heldout 1024x512, 300 steps) with kt=L  3) results/E5/qwen05_screen_<cfg>_noft.json
# Usage: tools/run_tmux.sh <name> <gpu> nestvq -- <cpu prefix> bash experiments/10_screen/run_screen.sh <cfg> <d> <nbits> <L> "<kds>"
set -euo pipefail
CFG=${1:?cfg}; D=${2:?d}; NB=${3:?nbits}; L=${4:?L}; KDS=${5:?kds}
MODEL=/data/models/qwen2.5_0.5b_instruct
CKPT=/data/lsh/ckpts/weightvq/qwen05/screen/${CFG}_noft
OUT=/data/lsh/results_accept/screen/${CFG}_noft
cd /hai/home/lsh/SpecRQ
mkdir -p "$(dirname "$CKPT")" "$OUT"
CBW=$(python3 -c "print(' '.join(['%.10g' % (1/$L)]*$L))")
EVALK=$(seq $L -1 1 | tr '\n' ' ')
if [[ ! -e "$CKPT/args.pt" ]]; then
  [[ -e "$CKPT" ]] && { echo "partial $CKPT exists; refusing"; exit 1; }
  echo "[screen] train $CFG d=$D nbits=$NB L=$L CBW=$CBW $(date -Is)"
  (cd specrq/dbd && /usr/bin/time -v python main.py $MODEL wikitext2 \
    --nsamples=1024 --val_size=32 --model_seqlen=4096 \
    --num_codebooks=$L --nbits_per_codebook=$NB --in_group_size=$D --out_group_size=1 \
    --codebook_weights $CBW --hadamard --accum_dtype float64 \
    --relative_mse_tolerance=0.01 \
    --finetune_batch_size=32 --finetune_max_epochs=0 --finetune_early_stop=3 --finetune_keep_best \
    --local_batch_size=1 --offload_activations --devices cuda:0 \
    --eval_num_codebooks $EVALK --save $CKPT)
  echo "[screen] train done $(date -Is)"
fi
EV="python experiments/06_accept/draft_target_eval.py --model $MODEL --ckpt $CKPT --kt $L --n_windows 40"
TR="python experiments/06_accept/train_draft_codebooks.py --model $MODEL --ckpt $CKPT --kt $L --steps 300 --batch 4 --nsamples 1024 --seqlen 512"
for kd in $KDS; do
  o=$OUT/kd$kd; mkdir -p $o/eval
  echo "[screen] kd=$kd A $(date -Is)"
  [[ -e $o/eval/A_bf16.json ]] || $EV --kd $kd --out $o/eval/A_bf16.json
  echo "[screen] kd=$kd B $(date -Is)"
  [[ -e $o/train_B_bf16/draft_codebooks.pt ]] || $TR --kd $kd --out $o/train_B_bf16
  [[ -e $o/eval/B_bf16.json ]] || $EV --kd $kd --no_fp16 --draft $o/train_B_bf16/draft_codebooks.pt --out $o/eval/B_bf16.json
done
python experiments/10_screen/save_screen.py --cfg $CFG --d $D --nbits $NB --L $L --ckpt $CKPT --out $OUT \
  --log /data/lsh/logs/${SCREEN_JOB:-e5_screen_$CFG}.log --kds "$KDS"
echo "[screen] done $CFG $(date -Is)"
